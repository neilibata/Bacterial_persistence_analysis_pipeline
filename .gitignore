# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── OS / tooling ──
.DS_Store
.mplconfig/
# Per-process matplotlib config dirs (.mplconfig-s3, -lev, -p2 ...): the
# pattern above only matched the bare name, so eight of them were unignored.
.mplconfig-*/
.ipynb_checkpoints/
# Excel lock files, created beside a workbook while it is open.
~$*

# ── Generated pipeline outputs ──
/results/
/main_text_figures/
/metadata_summary/
/figures/section2_bayesian/
.pipeline_state/
# Flat view of the manifest figures: symlinks into /results/.
# Rebuild with tools/link_supplementary_figures.py.
/supplementary_figures/

# ── Rendered figure/table artifacts (regenerated by the pipeline) ──
*.pdf
*.png
*.svg
*.tif
*.tiff

# Generated metadata explorer (embeds aggregated metadata; regenerate with build_explorer.py)
tools/metadata_explorer/*.html

# ── Large external input data (obtain separately; see README) ──
# The multi-GB breadth/depth matrices and the sample metadata table are not
# distributed in git. Link them in with `bash setup_symlinks.sh <data_dir>`.
meancoverage_and_std_matrix_*.csv
meandepth_and_std_matrix_*.csv
combined_meancoverage_matrix_*.csv
combined_meandepth_matrix_*.csv
# The names above never matched what the pipeline actually reads: the files
# are combined_coverage_matrix_*.csv / combined_depth_matrix_*.csv (no
# "mean"), so 5.7 GB of matrices sat untracked but NOT ignored and would have
# gone into any `git add -A`.
combined_coverage_matrix_*.csv
combined_depth_matrix_*.csv

# ── Dated backups and snapshots (local history, not repository content) ──
/archive/
/.rename_backup/
/incoming_*/
/results_pre_*/
/results_partial_*/
/results_stale_*/
/main_text_figures_pre_*/
/logs/
logs_*.log
# resources/ holds large regenerable intermediates (levbackfill matrices,
# concordance logs), so its CONTENTS are excluded -- but not the directory
# itself, because git will not descend into an excluded directory and the
# negation below would never be reached.
/resources/*
# carter_sample_info.csv is Carter et al. 2023's own published sample list and
# the DEFINITION of the S6-S9 cohort: carter_cohort.py raises FileNotFoundError
# without it, so those figures cannot be rebuilt from a clone. It was excluded
# only as collateral of the directory-wide rule above, never deliberately.
!/resources/carter_sample_info.csv
combined_*_matrix_*.csv
metadata_Mar_16_2026.csv
# NOT a human-subjects exclusion. That question was settled on 2026-09-25:
# per-sample metadata going to the public repository is acceptable, and
# docs/metadata_audited.csv -- 18,306 rows sharing 112 of M1's 115 columns,
# including Age, Gender, BMI and all 67 disease_* flags -- has been tracked
# since 1dfe92b anyway, so this pattern was never providing the protection its
# old comment claimed.
#
# The rule stays only to sequence the deposit: M1 is added after the final
# pipeline run, so a superseded version does not end up permanently in
# history. DELETE THIS PATTERN at that point rather than force-adding around
# it, and delete the metadata_M1.xlsx / metadata_M1_audit.xlsx lines below
# with it.
metadata_*.csv

# M1 in its other containers. Excluded for the same sequencing reason as the
# CSV above, not for distribution policy. M2/M3 alone are already committed.
metadata_M1-M3.xlsx
# Same data, other containers. The rule above named only the CSV and the
# bundle, so the workbook builds -- which hold every column of M1 for all
# 18,303 samples -- were not excluded and would have gone in.
metadata_M1.xlsx
metadata_M1_audit.xlsx

# Image-hash cache for tools/match_manifest.py (29 MB, keyed on paths inside
# dated result snapshots; regenerated on demand).
tools/.fighash.json

# Keep the small, static reference inputs that ARE committed:
!combined_sgb_metadata.xlsx

# Manuscript extraction for the pre-submission diff (author manuscripts; not for release)
/manuscript_check/

# Cohort reconciliation ID lists (regenerate: python tools/reconcile_cohorts.py)
/results/cohort_reconciliation/
*.py.bak
.plotcache/

# Generated previews for docs/supplementary_figures.html
docs/figure_review_assets/

# ── Derivatives of M1, excluded for the same sequencing reason as M1 itself ──
# `metadata_*.csv` above does NOT match a suffixed backup such as
# metadata_M1.csv.pre_verified, because the pattern requires the name to end in
# .csv. Those backups are complete copies of the per-sample human-subject table,
# so name them explicitly rather than trusting the glob.
final_run/metadata_M1.csv.*
metadata_M1.csv.*

# Audit workbooks and maps built FROM M1. Each carries individual-level rows:
#   subject_id_audit.xlsx      'Per sample'   18,303 rows, sample -> individual
#   m1_verification_audit.xlsx 'Per sample'   18,303 rows
#   cmd_health_audit.xlsx      'Paper trail'   9,458 rows with age/sex/BMI/disease
#   subject_ids.csv                            sample -> individual linkage
# They go in with M1 after the final run, not before.
docs/subject_id_audit.xlsx
docs/m1_verification_audit.xlsx
docs/cmd_health_audit.xlsx
final_run/subject_ids.csv

# Compressed, split copies of the large inputs, built by
# tools/prepare_deposit.py for the Zenodo deposit. Derived from the matrices
# above, which are themselves not in git.
deposit_stage/

# Whole-file staging for a hand-uploaded (drag-and-drop) deposit.
deposit_whole/

# Superseded run outputs, moved aside rather than deleted (see the
# README.txt inside). Never deposited, never published.
_superseded_*/
